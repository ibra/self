---
import Heading from "@components/Heading.astro";
import Nav from "@components/Nav.astro";
import Container from "@components/Container.astro";
import Layout from "@layouts/BaseLayout.astro";
---

<Layout title="ibrahim hisham" centered>
  <Container>
    <img
      src="https://avatars.githubusercontent.com/u/61324615?s=400&u=cd5a3ad6174065373219381434f09a76525f7bde&v=4"
      width="192"
      height="192"
      class="w-48 rounded-md animate-fade stagger-50"
      alt="profile picture"
      draggable="false"
    />
    <Heading title="ibrahim hisham" styling="stagger-100" />
    <p class="stagger-150 animate-fade text-lg">
      independent game developer. programmer working on systems, tools and
      libraries.
    </p>
    <br />
    <p class="stagger-200 animate-fade text-lg">
      view all my links <a
        class="text-slate-200 hover:text-slate-400"
        href="/self">here</a
      >.
    </p>
    <br />
    <Nav />
  </Container>
</Layout>
