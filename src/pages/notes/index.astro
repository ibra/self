---
import Nav from "@components/Nav.astro";
import Layout from "@layouts/BaseLayout.astro";
import Container from "@components/Container.astro";
import CompactListItem from "@components/CompactListItem.astro";
import Heading from "@components/Heading.astro";
import TabPanels from "@components/TabPanels.astro";
import TabPanel from "@components/TabPanel.astro";

const notePosts = await Astro.glob("./**/*.md");
const poetryPosts = await Astro.glob("../poetry/**/*.md");

const allPosts = [...notePosts, ...poetryPosts].map((post) => ({
  ...post,
  type: post.url?.includes("/poetry/") ? "poetry" : "note",
}));

const sortedPosts = allPosts.sort(
  (a: any, b: any) =>
    (new Date(b.frontmatter.date) as any) -
    (new Date(a.frontmatter.date) as any)
);

const nonArchivedPosts = sortedPosts.filter((post: any) => !post.frontmatter.archive);

const allTags = new Set<string>();
nonArchivedPosts.forEach((post: any) => {
  if (post.frontmatter.tags) {
    post.frontmatter.tags.forEach((tag: string) => allTags.add(tag));
  }
});

// poetry is kept apart: it sits last, behind a divider, and isn't counted in "all".
const tags = [
  "all",
  ...Array.from(allTags)
    .filter((tag) => tag !== "poetry")
    .sort(),
  ...(allTags.has("poetry") ? ["poetry"] : []),
];

const defaultIndex = 0;

const postsByTag: Record<string, any[]> = {
  all: nonArchivedPosts.filter(
    (post: any) => !post.frontmatter.tags?.includes("poetry")
  ),
};

allTags.forEach((tag) => {
  postsByTag[tag] = nonArchivedPosts.filter((post: any) =>
    post.frontmatter.tags?.includes(tag)
  );
});
---

<Layout title="ibrahim hisham ~ notes">
  <Container>
    <Nav />
    <Heading title="notes" styling="stagger-50" />
    <p class="stagger-100 animate-fade text-lg mb-5">
      some blips from the void.
    </p>

    <TabPanels
      items={tags}
      defaultIndex={defaultIndex}
      divideBefore={tags.indexOf("poetry")}
      syncHash
    >
      {
        tags.map((tag, index) => (
          <TabPanel active={index === defaultIndex}>
            <ul class="list-none text-base">
              {postsByTag[tag].map((post: any) => (
                <CompactListItem
                  url={post.url}
                  title={post.frontmatter.title}
                  date={new Date(post.frontmatter.date).toLocaleDateString(
                    "en-US",
                    {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    }
                  )}
                  type={post.type}
                />
              ))}
            </ul>
          </TabPanel>
        ))
      }
    </TabPanels>

    <p class="text-sm mt-8 animate-fade stagger-300">
      rss: <a href="/rss-notes.xml" class="text-slate-200 hover:text-slate-400"
        >notes</a
      > <span class="text-slate-600">·</span> <a
        href="/rss-poetry.xml"
        class="text-slate-200 hover:text-slate-400">poetry</a
      >
    </p>
  </Container>
</Layout>
