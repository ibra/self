---
import DetailModal from "@components/DetailModal.astro";
import Nav from "@components/Nav.astro";
import Layout from "@layouts/BaseLayout.astro";
import Container from "@components/Container.astro";
import Heading from "@components/Heading.astro";
import TabPanels from "@components/TabPanels.astro";
import TabPanel from "@components/TabPanel.astro";

const poetryPosts = await Astro.glob("./poetry/**/*.md");
const sortedPoetry = poetryPosts
  .sort(
    (a, b) =>
      (new Date(b.frontmatter.date) as any) -
      (new Date(a.frontmatter.date) as any)
  )
  .slice(0, 4);

const categories = [
  {
    name: "games",
    items: [
      {
        title: "fogbound",
        description:
          "narrative-driven psychological horror game set in a toxic, fog-ridden lahore.",
        url: "https://store.steampowered.com/app/4140990/FOGBOUND/",
        metadata: "2025, Steam",
        delay: 150,
      },
      {
        title: "pointblank",
        description:
          "fast-paced twin-stick shooter where you have a single bullet.",
        url: "https://store.steampowered.com/app/1221330/Pointblank",
        metadata: "2020, Steam",
        delay: 250,
      },
      {
        title: "more... (itch.io)",
        description:
          "collection of various little games made for jams and competitions.",
        url: "https://ibrahh.itch.io",
        metadata: "itch.io",
        delay: 350,
      },
    ],
  },
  {
    name: "software",
    items: [
      {
        title: "lachesis",
        description:
          "lightweight cross-platform time-tracking application written in rust.",
        url: "https://github.com/ibra/lachesis",
        metadata: "2024, Rust",
        delay: 150,
      },
      {
        title: "snip.tf",
        description:
          "a modern, minimalistic pastebin. developed backend in rust, deployed on the edge.",
        url: "https://snip.tf/",
        metadata: "2024, Rust",
        delay: 250,
      },
      {
        title: "ibralogue",
        description:
          "robust, extensible dialogue framework for the unity game engine.",
        url: "https://github.com/Ibralogue/Ibralogue",
        metadata: "2021, C#",
        delay: 350,
      },
    ],
  },
];
---

<Layout title="ibrahim hisham ~ work">
  <Container>
    <Nav />
    <Heading title="work" styling="stagger-50" />
    <p class="stagger-100 animate-fade text-lg mb-5">
      trying to find signal.
    </p>

    <TabPanels items={categories.map((cat) => cat.name)}>
      {
        categories.map((cat, index) => (
          <TabPanel active={index === 0}>
            <ul class="flex flex-col">
              {cat.items.map((item) => (
                <DetailModal
                  title={item.title}
                  description={item.description}
                  url={item.url}
                  delay={item.delay}
                />
              ))}
            </ul>
          </TabPanel>
        ))
      }
    </TabPanels>
  </Container>
</Layout>
