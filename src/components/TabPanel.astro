---
interface Props {
  active?: boolean;
}

const { active = false } = Astro.props;
---

<div
  class={`tab-panel w-full transition-opacity duration-500 ease-in-out ${
    active ? "relative" : "absolute top-0 left-0"
  }`}
  style={`opacity: ${active ? "1" : "0"}; pointer-events: ${
    active ? "auto" : "none"
  }`}
>
  <slot />
</div>
