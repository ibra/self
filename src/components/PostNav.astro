---
interface Props {
  previous?: { url: string; title: string };
  next?: { url: string; title: string };
}

const { previous, next } = Astro.props;
---

<div
  class="flex items-start justify-between gap-4 mt-10 text-slate-400 text-sm animate-fade stagger-300"
>
  {
    previous ? (
      <a
        href={previous.url}
        class="text-slate-200 hover:text-slate-400 transition-colors flex-1 lowercase"
      >
        ← {previous.title}
      </a>
    ) : (
      <span class="text-slate-600 flex-1">←</span>
    )
  }
  <a href="/notes" class="text-slate-200 hover:text-slate-400 transition-colors">
    notes
  </a>
  {
    next ? (
      <a
        href={next.url}
        class="text-slate-200 hover:text-slate-400 transition-colors flex-1 text-right lowercase"
      >
        {next.title} →
      </a>
    ) : (
      <span class="text-slate-600 flex-1 text-right">→</span>
    )
  }
</div>
