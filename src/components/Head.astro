---
interface Props {
  title: string;
  description?: string;
  date?: string;
}

const {
  title,
  description = "ibrahim hisham. independent game developer and software engineer from lahore. writing long and short things sometimes.",
  date,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";

// tells search engines which profiles belong to the same person.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ibrahim Hisham",
  alternateName: "ibra",
  url: "https://ibra.pk",
  image: "https://avatars.githubusercontent.com/u/61324615?v=4",
  jobTitle: "Independent game developer and software engineer",
  homeLocation: { "@type": "Place", name: "Lahore, Pakistan" },
  sameAs: [
    "https://github.com/ibra",
    "https://ibrahh.itch.io",
    "https://bsky.app/profile/ibrhm.bsky.social",
    "https://www.linkedin.com/in/ibrahh",
    "https://letterboxd.com/ibrahh/",
    "https://instagram.com/generatednoise",
  ],
};
---

<head>
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="follow, index" />
  <meta name="description" content={description} />
  <meta property="og:type" content={date ? "article" : "website"} />
  <meta property="og:site_name" content="ibrahim hisham" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta
    property="og:image"
    content="https://avatars.githubusercontent.com/u/61324615?v=4"
  />
  {date && <meta property="article:published_time" content={date} />}
  <meta name="twitter:card" content="summary" />
  {
    isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(person)} />
    )
  }
  <meta name="theme-color" content="#050505" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title="ibrahim hisham ~ notes"
    href="/rss-notes.xml"
  />
  <link
    rel="alternate"
    type="application/rss+xml"
    title="ibrahim hisham ~ poetry"
    href="/rss-poetry.xml"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
    rel="stylesheet"
  />
</head>
